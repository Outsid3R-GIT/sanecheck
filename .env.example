# --- SaneCheck config (copy to .env or set as env vars) ---

# Require this key on /ingest (leave empty to disable auth for local testing)
SANECHECK_API_KEY=changeme-123

# SQLite file
SANECHECK_DB=sanecheck.db

# --- Alerts: email (optional) ---
ALERT_EMAIL_TO=you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-app-password

# --- Alerts: generic webhook (optional) — Slack/Discord/Telegram-compatible JSON {"text": ...} ---
ALERT_WEBHOOK=

# --- Check tuning (optional) ---
CHECK_MIN_LENGTH=5
CHECK_EXPECT_JSON=false
# CHECK_MAX_TOKENS=8000
# CHECK_MAX_STEPS=25

# Max stored raw payload chars per run (for the dashboard debug view)
SANECHECK_RAW_CAP=50000
# Optional: redirect every other hostname (e.g. an old deploy) to this URL with 308
# SANECHECK_CANONICAL_URL=https://sanecheck.sanelabs.dev
# Anonymous daily usage ping (instance uuid, version, runs bucket). Set to 0 to disable.
# SANECHECK_TELEMETRY=1
# Housekeeping
# SANECHECK_RETENTION_DAYS=90
# SANECHECK_MIN_FREE_MB=2048
# CHECK_VOLUME_DROP=0.2
